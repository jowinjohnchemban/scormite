# Normalise line endings to LF in the repo; check out as-is on all platforms.
* text=auto eol=lf

# Force LF for files that must never have CRLF
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.svg       text eol=lf
*.sh        text eol=lf

# Treat these as binary — no diff, no merge, no line-ending conversion
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary
*.zip       binary
*.mp4       binary
*.mp3       binary

# Lockfile — text but collapse in diffs
pnpm-lock.yaml  text eol=lf linguist-generated=true
