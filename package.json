{
  "name": "scormite",
  "version": "1.0.0",
  "description": "Test, debug, and validate SCORM 1.2 and 2004 packages in your browser before uploading them to an LMS.",
  "license": "MIT",
  "author": {
    "name": "Jowin John Chemban",
    "email": "scormite@jowinjc.in",
    "url": "https://jowinjc.in"
  },
  "homepage": "https://scormite.jowinjc.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jowinjohnchemban/scormite.git"
  },
  "bugs": {
    "url": "https://github.com/jowinjohnchemban/scormite/issues"
  },
  "keywords": [
    "scorm",
    "scorm-1.2",
    "scorm-2004",
    "scorm-player",
    "scorm-debugger",
    "e-learning",
    "lms",
    "imsmanifest",
    "scorm-again"
  ],
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "diagram": "node build/architecture.ts",
    "release:prepare": "node build/release.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.8",
    "scorm-again": "^3.4.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@11.20.0"
}
